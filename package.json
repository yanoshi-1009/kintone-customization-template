{
  "name": "kintone-customization",
  "version": "1.0.0",
  "description": "This is my kintone customization template.",
  "keywords": [
    "kintone"
  ],
  "author": "y.idakko@gmail.com",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yanoshi-1009/kintone-customization-template"
  },
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=26.0.0",
      "onFail": "error"
    },
    "packageManager": {
      "name": "pnpm",
      "version": ">=11.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "init": "node ./scripts/init.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "build:prod": "pnpm run typecheck && node ./scripts/esbuild/build.ts --mode=production",
    "build:dev": "pnpm run typecheck && node ./scripts/esbuild/build.ts --mode=development"
  },
  "dependencies": {
    "@kintone/rest-api-client": "6.2.1",
    "chart.js": "4.5.1",
    "dayjs": "1.11.21",
    "i18next": "26.3.6",
    "kintone-ui-component": "1.26.0"
  },
  "devDependencies": {
    "@cybozu/eslint-config": "26.0.0",
    "@kintone/dts-gen": "9.0.8",
    "@types/node": "26.2.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
