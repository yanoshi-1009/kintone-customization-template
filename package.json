{
  "name": "kintone-customization",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "26.13.1",
      "onFail": "download"
    },
    "packageManager": {
      "name": "pnpm",
      "version": "12.21.0",
      "onFail": "download"
    }
  },
  "scripts": {
    "init": "node ./scripts/init.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit && tsc -p scripts --noEmit",
    "build:prod": "pnpm run typecheck && node ./scripts/esbuild/build.ts --mode=production",
    "build:dev": "pnpm run typecheck && node ./scripts/esbuild/build.ts --mode=development"
  },
  "dependencies": {
    "@kintone/rest-api-client": "7.0.0",
    "chart.js": "4.6.1",
    "dayjs": "1.11.23",
    "i18next": "27.1.5",
    "kintone-ui-component": "1.26.0"
  },
  "devDependencies": {
    "@cybozu/eslint-config": "26.2.0",
    "@kintone/dts-gen": "10.0.0",
    "@types/node": "26.6.6",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "prettier": "3.10.1",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
